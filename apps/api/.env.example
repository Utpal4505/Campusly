# Copy this file to `.env` and fill in your actual values.
# NEVER commit the `.env` file — it is gitignored.

# ──────────────────────────────────────
# Database (Supabase PostgreSQL)
# ──────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# ──────────────────────────────────────
# Better Auth
# ──────────────────────────────────────
# Secret for encryption/hashing — at least 32 characters.
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# Base URL where the API is running
BETTER_AUTH_URL="http://localhost:4000"

# ──────────────────────────────────────
# Application
# ──────────────────────────────────────
PORT=4000
FRONTEND_URL="http://localhost:3000"

# ──────────────────────────────────────
# Google OAuth 2.0 (Better Auth Social Provider)
# ──────────────────────────────────────
# Obtain from Google Cloud Console > APIs & Services > Credentials
# Callback URL: http://localhost:4000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ──────────────────────────────────────
# Email Delivery (Resend)
# ──────────────────────────────────────
# If left blank, Campusly automatically runs a Dev Email Simulator
# and outputs the 6-digit verification code directly to the API console.
RESEND_API_KEY=""
EMAIL_FROM="Campusly <onboarding@resend.dev>"

# ──────────────────────────────────────
# Payment Gateway (Razorpay)
# ──────────────────────────────────────
# Obtain from Razorpay Dashboard > Settings > API Keys
# If left blank, Campusly runs a test mode payment simulator.
RAZORPAY_KEY_ID="rzp_test_campusly_dev"
RAZORPAY_KEY_SECRET="campusly_dev_secret"
